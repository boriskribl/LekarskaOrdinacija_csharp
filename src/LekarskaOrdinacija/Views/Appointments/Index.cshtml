@model IEnumerable<Appointment>
@{ViewData["Title"]="Termini";}<div class="d-flex justify-content-between mb-3"><h2>Termini</h2>@if(User.IsInRole("Administrator")||User.IsInRole("Doctor")){<a asp-action="Create" class="btn btn-primary">Zakaži termin</a>}</div><table class="table table-striped"><thead><tr><th>Datum/vreme</th><th>Pacijent</th><th>Lekar</th><th>Usluga</th><th>Status</th><th>Cena</th><th>Akcije</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Start.ToString("dd.MM.yyyy HH:mm")</td><td>@a.Patient?.FullName</td><td>@a.Doctor?.FullName</td><td>@a.MedicalService?.Name</td><td>@a.Status</td><td>@a.FinalPrice.ToString("N2") RSD</td><td><form asp-action="SetStatus" method="post" class="d-inline"><input type="hidden" name="id" value="@a.Id"/><input type="hidden" name="status" value="Completed"/><button class="btn btn-sm btn-success">Realizovan</button></form> <form asp-action="SetStatus" method="post" class="d-inline"><input type="hidden" name="id" value="@a.Id"/><input type="hidden" name="status" value="Cancelled"/><button class="btn btn-sm btn-outline-secondary">Otkaži</button></form></td></tr>}</tbody></table>