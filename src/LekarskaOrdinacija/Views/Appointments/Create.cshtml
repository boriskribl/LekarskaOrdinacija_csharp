@model Appointment
@{ViewData["Title"]="Novi termin";}<h2>Novi termin</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label>Pacijent</label><select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-select"></select></div><div class="mb-3"><label>Lekar</label><select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select"></select></div><div class="mb-3"><label>Usluga</label><select asp-for="MedicalServiceId" asp-items="ViewBag.Services" class="form-select"></select></div><div class="mb-3"><label>Datum i vreme</label><input asp-for="Start" type="datetime-local" class="form-control"/></div><div class="mb-3"><label>Napomena</label><textarea asp-for="Note" class="form-control"></textarea></div><button class="btn btn-primary">Zakaži</button></form>