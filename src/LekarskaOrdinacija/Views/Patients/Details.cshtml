@model LekarskaOrdinacija.Models.Patient
<h2>Detalji</h2><dl class="row"><dt class="col-sm-4">Ime</dt><dd class="col-sm-8">@Model.FirstName</dd><dt class="col-sm-4">Prezime</dt><dd class="col-sm-8">@Model.LastName</dd><dt class="col-sm-4">Adresa</dt><dd class="col-sm-8">@Model.Address</dd><dt class="col-sm-4">Datum rođenja</dt><dd class="col-sm-8">@Model.DateOfBirth</dd><dt class="col-sm-4">Telefon</dt><dd class="col-sm-8">@Model.Phone</dd><dt class="col-sm-4">Imejl</dt><dd class="col-sm-8">@Model.Email</dd></dl><a asp-action="Index" class="btn btn-secondary">Nazad</a>