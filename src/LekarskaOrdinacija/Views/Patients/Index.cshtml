@model IEnumerable<LekarskaOrdinacija.Models.Patient>
@{ViewData["Title"]="Patients";}<div class="d-flex justify-content-between align-items-center mb-3"><h2>Patients</h2>@if(User.IsInRole("Administrator") || User.IsInRole("Doctor")){<a asp-action="Create" class="btn btn-primary">Dodaj</a>}</div><table class="table table-striped"><thead><tr><th>Ime</th><th>Prezime</th><th>Adresa</th><th>Datum rođenja</th><th>Telefon</th><th>Imejl</th><th>Akcije</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.FirstName</td><td>@item.LastName</td><td>@item.Address</td><td>@item.DateOfBirth</td><td>@item.Phone</td><td>@item.Email</td><td><a asp-action="Details" asp-route-id="@item.Id">Detalji</a> @if(User.IsInRole("Administrator") || User.IsInRole("Doctor")){<text> | <a asp-action="Edit" asp-route-id="@item.Id">Izmeni</a> | <a asp-action="Delete" asp-route-id="@item.Id">Obriši</a></text>}</td></tr>}</tbody></table>