@model DoctorSchedule
<h2>Novo radno vreme</h2><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label>Lekar</label><select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-select"></select></div><div class="mb-3"><label>Dan</label><select asp-for="DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select"></select></div><div class="mb-3"><label>Od</label><input asp-for="StartTime" type="time" class="form-control"/></div><div class="mb-3"><label>Do</label><input asp-for="EndTime" type="time" class="form-control"/></div><button class="btn btn-primary">Sačuvaj</button></form>