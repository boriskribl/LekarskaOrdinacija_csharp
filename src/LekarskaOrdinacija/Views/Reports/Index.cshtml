@model IEnumerable<Appointment>
@{ViewData["Title"]="Izveštaji";}<h2>Izveštaji i pregledi</h2><form method="get" class="row g-2 mb-4"><div class="col"><input name="patientId" class="form-control" placeholder="ID pacijenta"/></div><div class="col"><input name="doctorId" class="form-control" placeholder="ID lekara"/></div><div class="col"><input name="from" type="date" class="form-control"/></div><div class="col"><input name="to" type="date" class="form-control"/></div><div class="col"><button class="btn btn-primary">Filtriraj</button></div></form><table class="table"><thead><tr><th>Datum</th><th>Pacijent</th><th>Lekar</th><th>Usluga</th><th>Status</th><th>Cena</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Start</td><td>@a.Patient?.FullName</td><td>@a.Doctor?.FullName</td><td>@a.MedicalService?.Name</td><td>@a.Status</td><td>@a.FinalPrice</td></tr>}</tbody></table><h4>Po lekaru</h4><table class="table"><tr><th>Lekar</th><th>Zakazano</th><th>Realizovano</th></tr>@foreach(var x in ViewBag.ByDoctor){<tr><td>@x.Doctor</td><td>@x.Scheduled</td><td>@x.Completed</td></tr>}</table><h4>Učestalost usluga</h4><table class="table"><tr><th>Usluga</th><th>Broj</th></tr>@foreach(var x in ViewBag.ByService){<tr><td>@x.Service</td><td>@x.Count</td></tr>}</table>