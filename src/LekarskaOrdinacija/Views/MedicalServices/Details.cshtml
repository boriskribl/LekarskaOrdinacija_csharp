@model LekarskaOrdinacija.Models.MedicalService
<h2>Detalji</h2><dl class="row"><dt class="col-sm-4">Naziv</dt><dd class="col-sm-8">@Model.Name</dd><dt class="col-sm-4">Cena</dt><dd class="col-sm-8">@Model.Price</dd><dt class="col-sm-4">Trajanje (min)</dt><dd class="col-sm-8">@Model.DurationMinutes</dd><dt class="col-sm-4">Opis</dt><dd class="col-sm-8">@Model.Description</dd></dl><a asp-action="Index" class="btn btn-secondary">Nazad</a>