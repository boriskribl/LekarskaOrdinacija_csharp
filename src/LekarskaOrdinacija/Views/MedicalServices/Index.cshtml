@model IEnumerable<LekarskaOrdinacija.Models.MedicalService>
@{ViewData["Title"]="MedicalServices";}<div class="d-flex justify-content-between align-items-center mb-3"><h2>MedicalServices</h2>@if(User.IsInRole("Administrator") || User.IsInRole("Doctor")){<a asp-action="Create" class="btn btn-primary">Dodaj</a>}</div><table class="table table-striped"><thead><tr><th>Naziv</th><th>Cena</th><th>Trajanje (min)</th><th>Opis</th><th>Akcije</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Name</td><td>@item.Price</td><td>@item.DurationMinutes</td><td>@item.Description</td><td><a asp-action="Details" asp-route-id="@item.Id">Detalji</a> @if(User.IsInRole("Administrator") || User.IsInRole("Doctor")){<text> | <a asp-action="Edit" asp-route-id="@item.Id">Izmeni</a> | <a asp-action="Delete" asp-route-id="@item.Id">Obriši</a></text>}</td></tr>}</tbody></table>